{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "${configDir}/.tsbuild/types",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "tsBuildInfoFile": "${configDir}/.tsbuild/tsconfig.tsbuildinfo"
  }
}
