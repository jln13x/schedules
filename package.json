      "@tailwindcss/typography": "0.5.20",
      "@types/node": "25.6.0",
      "@types/pg": "8.23.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@upstash/ratelimit": "2.2.0",
      "@upstash/redis": "1.40.0",
      "@vercel/config": "0.12.0",
