      "oxfmt": "0.73.0",
      "oxlint": "1.88.0",
      "pg": "8.23.1",
      "postcss": "8.5.30",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-markdown": "10.1.0",
      "smol-toml": "1.9.1",
      "sonner": "2.0.8",
      "stripe": "23.0.1",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "typescript": "7.0.2",
      "yaml": "2.9.1",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "oxlint --report-unused-disable-directives .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:push": "bun run --cwd apps/web db:push",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "infra:up": "docker compose up --detach --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
